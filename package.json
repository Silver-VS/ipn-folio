{
  "name": "ipn-folio",
  "version": "0.0.0",
  "private": true,
  "description": "Editor LaTeX y cuadernos académicos en el navegador, sin servidores, para el alumnado del IPN",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "formato": "prettier --write .",
    "tipos": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "licencias": "node scripts/licencias.mjs",
    "activos": "node scripts/activos.mjs",
    "contenido": "node scripts/textos.mjs && node scripts/codificacion.mjs && node scripts/contenido.mjs",
    "verificar": "npm run contenido && npm run lint && npm run tipos && npm run test && npm run licencias && npm run build",
    "espejo:generar": "node scripts/espejo/generar.mjs",
    "espejo:validar": "node scripts/espejo/validar.mjs",
    "espejo:servir": "node scripts/espejo/servir.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@ipn/comun": "github:Silver-VS/ipn-comun#v0.1.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror-lang-latex": "^0.6.1",
    "dockview": "^8.4.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "pdfjs-dist": "^6.4.299",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "smol-toml": "^1.9.0",
    "svelte-check": "^4.7.6",
    "texlyre-busytex": "1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
